body {
    width: 100%;
    height: 100%;
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Roboto";
}

.container {
    width: 90%;
    height: 90%;
    margin: 5% auto;
    display: flex;
    flex-direction: row;
    gap: 20px;
}

.panel {
    flex: 1;
    background-color: #2d2d2d;
    border-width: 1px;
    border-color: #3e3e3e;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.panel h1 {
    font-size: 24px;
    color: #61afef;
    margin: 0;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: #3e3e3e;
}

.status-box {
    background-color: #252525;
    border-width: 1px;
    border-color: #3e3e3e;
    border-radius: 4px;
    padding: 15px;
}

.status-box p {
    margin: 8px 0;
    font-size: 18px;
    line-height: 1.8;
}

.label {
    color: #98c379;
    font-weight: bold;
}

.value {
    color: #e5c07b;
}

.description {
    color: #abb2bf;
    font-size: 13px;
    line-height: 1.5;
    margin-top: 10px;
}