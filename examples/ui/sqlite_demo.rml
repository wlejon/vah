<rml>
<head>
    <title>SQLite Database Demo</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="sqlite_demo.rcss"/>
    <script>
        function save_contact(document, event)
            local button = event.current_element
            local cid = button:GetAttribute('data-cid')
            local name = document:GetElementById('name_' .. cid):GetAttribute('value')
            local email = document:GetElementById('email_' .. cid):GetAttribute('value')
            local phone = document:GetElementById('phone_' .. cid):GetAttribute('value')
            local company = document:GetElementById('company_' .. cid):GetAttribute('value')
            emit('save_contact', {
                id = tonumber(cid),
                name = name,
                email = email,
                phone = phone,
                company = company
            })
        end

        function delete_contact(document, event)
            local button = event.current_element
            local cid = button:GetAttribute('data-cid')
            emit('delete_contact', {id = tonumber(cid)})
        end
    </script>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>SQLite Contact Manager</h1>
            <p class="subtitle">Persistent database with editable table view</p>
        </div>

        <div class="toolbar">
            <div class="toolbar-left" data-model="contacts">
                Total: {{contacts.size}} contacts
            </div>
            <div class="toolbar-right">
                <button onclick="emit('add_contact')">Add Random Contact</button>
            </div>
        </div>

        <div class="table-container" data-model="contacts">
            <div data-if="contacts.size == 0">
                <div class="empty-state">No contacts yet. Click "Add Random Contact" to create one.</div>
            </div>
            <div data-if="contacts.size > 0">
                <!-- Table header -->
                <div class="table-header">
                    <div class="col-name">Name</div>
                    <div class="col-email">Email</div>
                    <div class="col-phone">Phone</div>
                    <div class="col-company">Company</div>
                    <div class="col-actions">Actions</div>
                </div>

                <!-- Table rows using data-for -->
                <div data-for="contact, i : contacts">
                    <div class="table-row" data-attr-id="'row_' + contact.id" data-attr-data-contact-id="contact.id">
                        <div class="col-name">
                            <input type="text"
                                   data-attr-id="'name_' + contact.id"
                                   data-attr-value="contact.name" />
                        </div>
                        <div class="col-email">
                            <input type="text"
                                   data-attr-id="'email_' + contact.id"
                                   data-attr-value="contact.email" />
                        </div>
                        <div class="col-phone">
                            <input type="text"
                                   data-attr-id="'phone_' + contact.id"
                                   data-attr-value="contact.phone" />
                        </div>
                        <div class="col-company">
                            <input type="text"
                                   data-attr-id="'company_' + contact.id"
                                   data-attr-value="contact.company" />
                        </div>
                        <div class="col-actions">
                            <button class="btn-save" data-attr-data-cid="contact.id" onclick="save_contact(document, event)">Save</button>
                            <button class="btn-delete" data-attr-data-cid="contact.id" onclick="delete_contact(document, event)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
