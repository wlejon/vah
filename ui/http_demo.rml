<rml>
<head>
    <title>HTTP SSE Demo</title>
    <style>
        body {
            width: 100%;
            height: 100%;
            background-color: #1e1e1e;
            color: #d4d4d4;
            font-family: "Roboto";
        }

        .container {
            width: 90%;
            height: 90%;
            margin: 5% auto;
            display: flex;
            flex-direction: row;
            gap: 20px;
        }

        .panel {
            flex: 1;
            background-color: #2d2d2d;
            border-width: 1px;
            border-color: #3e3e3e;
            border-radius: 8px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .panel h1 {
            font-size: 24px;
            color: #61afef;
            margin: 0;
            padding-bottom: 10px;
            border-bottom-width: 2px;
            border-bottom-color: #3e3e3e;
        }

        .status-box {
            background-color: #252525;
            border-width: 1px;
            border-color: #3e3e3e;
            border-radius: 4px;
            padding: 15px;
        }

        .status-box p {
            margin: 8px 0;
            font-size: 14px;
            line-height: 1.6;
        }

        .label {
            color: #98c379;
            font-weight: bold;
        }

        .value {
            color: #e5c07b;
        }

        .description {
            color: #abb2bf;
            font-size: 13px;
            line-height: 1.5;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Server Panel -->
        <div class="panel">
            <h1>HTTP Server</h1>
            <div class="description">
                Server sends counter events every second via Server-Sent Events (SSE).
                Endpoint: GET /events
            </div>
            <div class="status-box">
                <p id="server-status" class="value">Status: Initializing...</p>
                <p id="server-messages" class="label">Messages sent: 0</p>
            </div>
        </div>

        <!-- Client Panel -->
        <div class="panel">
            <h1>HTTP Client</h1>
            <div class="description">
                Client connects to the server and receives SSE events in real-time.
                Connection: http://127.0.0.1:8080/events
            </div>
            <div class="status-box">
                <p id="client-status" class="value">Status: Waiting for connection...</p>
                <p id="client-messages" class="label">Messages received: 0</p>
                <p id="client-last-event" class="description">Last event: None</p>
            </div>
        </div>
    </div>
</body>
</rml>
