<rml>
<head>
    <title>HTTP SSE Demo</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="http_demo.rcss"/>
</head>
<body>
    <div class="container">
        <!-- Server Panel -->
        <div class="panel" data-model="http_server">
            <div data-for="s : http_server">
                <h1>HTTP Server</h1>
                <div class="description">
                    Server sends counter events every second via Server-Sent Events (SSE).
                    Endpoint: GET /events
                </div>
                <div class="status-box">
                    <p class="value">{{s.status}}</p>
                    <p class="label">Messages sent: {{s.messages}}</p>
                </div>
            </div>
        </div>

        <!-- Client Panel -->
        <div class="panel" data-model="http_client">
            <div data-for="c : http_client">
                <h1>HTTP Client</h1>
                <div class="description">
                    Client connects to the server and receives SSE events in real-time.
                    Connection: http://127.0.0.1:8080/events
                </div>
                <div class="status-box">
                    <p class="value">{{c.status}}</p>
                    <p class="label">Messages received: {{c.messages}}</p>
                    <p class="description">Last event: {{c.last_event}}</p>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
