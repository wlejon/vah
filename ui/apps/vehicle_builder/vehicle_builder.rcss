body {
    font-family: 'Roboto', sans-serif;
    background-color: #1a1a2e;
    color: #eee;
    margin: 0;
    padding: 0;
}

.container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.header {
    background-color: #16213e;
    padding: 20px;
    text-align: center;
    border-bottom: 3px solid #0f3460;
}

.header h1 {
    margin: 0 0 10px 0;
    color: #e94560;
    font-size: 32px;
}

.game-status {
    font-size: 18px;
    font-weight: bold;
    color: #00d9ff;
    text-transform: uppercase;
}

.main-content {
    display: flex;
    flex: 1;
    overflow: hidden;
}

/* Toolbox (Left Panel) */
.toolbox {
    width: 300px;
    background-color: #16213e;
    border-right: 2px solid #0f3460;
    padding: 20px;
    overflow-y: auto;
}

.toolbox h2 {
    margin: 0 0 10px 0;
    color: #e94560;
    font-size: 24px;
}

.instruction {
    font-size: 14px;
    color: #aaa;
    margin-bottom: 20px;
    line-height: 1.4;
}

.component-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.component-item {
    display: block;
}

.component-item button {
    width: 100%;
    padding: 15px;
    background-color: #0f3460;
    border: 2px solid #0a2647;
    border-radius: 8px;
    color: #eee;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}

.component-item button:hover {
    background-color: #1a4d8f;
    border-color: #2563a8;
    transform: translateY(-2px);
}

.component-item.selected button {
    background-color: #e94560;
    border-color: #ff6b81;
    box-shadow: 0 0 10px rgba(233, 69, 96, 0.5);
}

.component-name {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 5px;
}

.component-desc {
    font-size: 13px;
    color: #ccc;
}

/* Game Area (Right Panel) */
.game-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px;
    background-color: #1a1a2e;
    overflow: auto;
}

canvas {
    display: block;
    width: 100%;
    max-width: 1000px;
    height: 700px;
    border: 3px solid #0f3460;
    border-radius: 8px;
    cursor: crosshair;
    background-color: #87ceeb;
}

.controls {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    flex-wrap: wrap;
}

button {
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-primary {
    background-color: #00d9ff;
    color: #1a1a2e;
}

.btn-primary:hover {
    background-color: #00b8d4;
    transform: scale(1.05);
}

.btn-secondary {
    background-color: #ffa500;
    color: #1a1a2e;
}

.btn-secondary:hover {
    background-color: #ff8c00;
    transform: scale(1.05);
}

.btn-danger {
    background-color: #e94560;
    color: #fff;
}

.btn-danger:hover {
    background-color: #d63447;
    transform: scale(1.05);
}

.instructions {
    margin-top: 30px;
    padding: 20px;
    background-color: #16213e;
    border: 2px solid #0f3460;
    border-radius: 8px;
    max-width: 800px;
}

.instructions h3 {
    margin: 0 0 15px 0;
    color: #00d9ff;
    font-size: 20px;
}

.instructions ol {
    margin: 0;
    padding-left: 25px;
    line-height: 1.8;
}

.instructions li {
    margin-bottom: 8px;
}

.instructions strong {
    color: #e94560;
}
