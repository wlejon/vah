body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: #1e1e2e;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.header {
    padding: 16px 20px;
    background: #181825;
    border-bottom: 1px #313244;
}

h1 {
    font-size: 24px;
    color: #89b4fa;
    margin: 0;
}

.main-container {
    flex: 1;
    display: flex;
    overflow: hidden;
}

/* File Browser Panel */
.browser-panel {
    width: 300px;
    background: #313244;
    border-right: 1px #181825;
    display: flex;
    flex-direction: column;
}

.path-bar {
    background: #181825;
    padding: 14px;
    font-size: 14px;
    color: #a6adc8;
    border-bottom: 1px #313244;
    white-space: nowrap;
    overflow: hidden;
}

.file-list {
    flex: 1;
    overflow-y: auto;
    padding: 4px;
}

.file-item {
    display: flex;
    padding: 8px 12px;
    margin-bottom: 1px;
    border-radius: 4px;
    cursor: pointer;
}

.file-item:hover {
    background: #45475a;
}

.file-icon {
    width: 24px;
    font-size: 14px;
    cursor: pointer;
}

.file-name {
    flex: 1;
    color: #cdd6f4;
    font-size: 13px;
    cursor: pointer;
}

/* Editor Panel */
.editor-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #1e1e2e;
}

.editor-header {
    padding: 12px 16px;
    background: #181825;
    border-bottom: 1px #313244;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.editor-header-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.editor-header-right {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-end;
}

.file-path {
    color: #89b4fa;
    font-size: 13px;
}

.modified-indicator {
    color: #f9e2af;
    font-size: 13px;
    margin-left: 8px;
    font-weight: bold;
}

.file-type {
    color: #a6adc8;
    font-size: 11px;
}

.file-info {
    color: #6c7086;
    font-size: 12px;
}

.editable-badge {
    color: #a6e3a1;
    font-size: 11px;
    background: #1e1e2e;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px #a6e3a1;
}

.readonly-badge {
    color: #f38ba8;
    font-size: 11px;
    background: #1e1e2e;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px #f38ba8;
}

.editor-content {
    flex: 1;
    overflow: auto;
    padding: 0;
}

.editor-scroll-container {
    width: 100%;
    height: 100%;
    overflow: auto;
    padding: 12px;
}

texteditor {
    display: block;
    font-family: "jetbrains mono";
    font-size: 14px;
    cursor: text;
    drag: drag;
    focus: auto;
    tab-index: auto;
}

.no-file-message {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #6c7086;
    font-size: 16px;
}

/* Scrollbar styling */
scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 1px;
    background: #6c7086;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}