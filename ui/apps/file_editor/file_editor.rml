<rml>
<head>
    <title>File Editor</title>
    <link type="text/rcss" href="/ui/reset.rcss"/>
    <link type="text/rcss" href="file_editor.rcss"/>
</head>
<body>
    <div class="header">
        <h1>File Editor</h1>
    </div>

    <div class="main-container">
        <!-- File Browser Panel -->
        <div class="browser-panel">
            <div data-model="browser_info">
                <div data-for="info : browser_info">
                    <div class="path-bar">{{info.current_path}}</div>
                </div>
            </div>

            <div class="file-list" data-model="files">
                <div data-for="file, i : files">
                    <div class="file-item" data-attr-data-target="file.target" data-attr-data-is-dir="file.is_dir" onclick="
                        local target = event.current_element:GetAttribute('data-target')
                        local is_dir = event.current_element:GetAttribute('data-is-dir')
                        emit('file_clicked', {target = target, is_dir = (is_dir == '1' or is_dir == 'true')})
                    ">
                        <span class="file-icon">{{file.icon}}</span>
                        <span class="file-name">{{file.name}}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Editor Panel -->
        <div class="editor-panel">
            <div class="editor-header" data-model="editor_info">
                <div data-for="info : editor_info">
                    <div class="editor-header-left">
                        <div>
                            <span class="file-path">{{info.file_path}}</span>
                            <span data-if="info.is_modified" class="modified-indicator">●</span>
                        </div>
                        <span class="file-type">{{info.file_type}}</span>
                    </div>
                    <div class="editor-header-right">
                        <span class="file-info">{{info.file_info}}</span>
                        <span data-if="info.is_editable" class="editable-badge">EDITABLE</span>
                        <span data-if="!info.is_editable" class="readonly-badge">READ-ONLY</span>
                    </div>
                </div>
            </div>

            <div class="editor-content">
                <div class="editor-scroll-container">
                    <texteditor id="code_editor" onmodified="emit('modified', {element_id = event.parameters.element_id, modified = event.parameters.modified, content = event.parameters.content})" onsave="emit('save', {element_id = event.parameters.element_id, content = event.parameters.content})" />
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
