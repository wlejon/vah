<rml>
<head>
    <title>Physics Demo</title>
    <link type="text/rcss" href="/ui/reset.rcss"/>
    <link type="text/rcss" href="physics_demo.rcss"/>
    <script>
    -- Render function for physics canvas
    -- Bodies array comes from data model (set by Lua thread)
    function render_physics(nvg_ctx, canvas_x, canvas_y, canvas_w, canvas_h, time)
        -- Get bodies from data model
        local demo_data = data and data.get and data.get("physics_bodies")
        if not demo_data or #demo_data == 0 then
            -- Draw "no data" message
            nvg.fontSize(nvg_ctx, 16.0)
            nvg.fontFace(nvg_ctx, "roboto")
            nvg.textAlign(nvg_ctx, nvg.ALIGN_CENTER + nvg.ALIGN_MIDDLE)
            nvg.fillColor(nvg_ctx, nvg.rgba(255, 255, 255, 255))
            nvg.text(nvg_ctx, canvas_x + canvas_w / 2, canvas_y + canvas_h / 2, "Waiting for physics data...")
            return
        end

        local bodies = demo_data[1].bodies
        if not bodies or #bodies == 0 then
            return
        end

        -- Clear background
        nvg.beginPath(nvg_ctx)
        nvg.rect(nvg_ctx, canvas_x, canvas_y, canvas_w, canvas_h)
        nvg.fillColor(nvg_ctx, nvg.rgba(30, 30, 30, 255))
        nvg.fill(nvg_ctx)

        -- Set up coordinate transform (physics uses meters, canvas uses pixels)
        -- Scale: 20 pixels per meter
        -- Origin: horizontally centered, 100px from bottom
        -- Y-down coordinate system (matches screen coordinates)
        local scale = 20
        local origin_x = canvas_x + canvas_w / 2
        local origin_y = canvas_y + canvas_h - 100

        -- Set up physics coordinate system transform
        -- This makes all subsequent drawing use physics coordinates directly
        nvg.save(nvg_ctx)
        nvg.translate(nvg_ctx, origin_x, origin_y)
        nvg.scale(nvg_ctx, scale, scale)  -- Same scale both axes (Y-down)

        -- Draw ground (in physics coordinates: at y=10, 50 meters wide, 1 meter tall)
        nvg.beginPath(nvg_ctx)
        nvg.rect(nvg_ctx, -25, 10, 50, 1)
        nvg.fillColor(nvg_ctx, nvg.rgba(68, 68, 68, 255))
        nvg.fill(nvg_ctx)

        -- Draw coordinate demo shapes first (behind balls)
        local demo_data = data and data.get and data.get("coord_demos")
        if demo_data and #demo_data > 0 then
            local world_id = demo_data[1].world_id
            local demos = demo_data[1].demos
            if demos and #demos > 0 then
                for i, demo in ipairs(demos) do
                    -- Create fresh view at 60Hz from body_id
                    local view, err = physics.create_body_view(world_id, demo.body_id)
                    if not view then
                        -- Skip this body if view creation failed
                        goto continue
                    end

                    nvg.save(nvg_ctx)
                    nvg.translate(nvg_ctx, view.pos_x, view.pos_y)  -- 60Hz position!
                    nvg.rotate(nvg_ctx, view.angle)  -- 60Hz angle!

                    if demo.type == "wheel_cw" or demo.type == "wheel_ccw" then
                        -- Draw spinning wheel (radius 1.0 meters in physics units)
                        local radius = 1.0

                        -- Wheel body - yellow
                        nvg.beginPath(nvg_ctx)
                        nvg.circle(nvg_ctx, 0, 0, radius)
                        nvg.fillColor(nvg_ctx, nvg.rgba(255, 200, 50, 200))
                        nvg.fill(nvg_ctx)

                        -- Draw radial lines to show rotation
                        nvg.strokeWidth(nvg_ctx, 0.15)  -- In physics units (scaled to pixels)
                        nvg.strokeColor(nvg_ctx, nvg.rgba(40, 40, 40, 255))
                        -- Main line at 0 degrees
                        nvg.beginPath(nvg_ctx)
                        nvg.moveTo(nvg_ctx, 0, 0)
                        nvg.lineTo(nvg_ctx, radius, 0)
                        nvg.stroke(nvg_ctx)
                        -- Perpendicular line
                        nvg.beginPath(nvg_ctx)
                        nvg.moveTo(nvg_ctx, 0, 0)
                        nvg.lineTo(nvg_ctx, 0, radius)
                        nvg.stroke(nvg_ctx)

                    elseif demo.type == "h_mover" or demo.type == "v_mover" or demo.type == "d_mover" then
                        -- Draw box mover (0.75 x 0.75 meters in physics units)
                        local half_size = 0.75

                        -- Choose color based on type
                        local r, g, b = 100, 255, 100  -- Default green for h_mover
                        if demo.type == "v_mover" then
                            r, g, b = 100, 150, 255  -- Blue for v_mover
                        elseif demo.type == "d_mover" then
                            r, g, b = 255, 100, 255  -- Purple for d_mover
                        end

                        nvg.beginPath(nvg_ctx)
                        nvg.rect(nvg_ctx, -half_size, -half_size, half_size * 2, half_size * 2)
                        nvg.fillColor(nvg_ctx, nvg.rgba(r, g, b, 200))
                        nvg.fill(nvg_ctx)
                    end

                    nvg.restore(nvg_ctx)

                    ::continue::  -- Label for skipping failed view creation
                end

                -- Draw text labels in screen coordinates (after all shapes)
                nvg.restore(nvg_ctx)  -- Exit physics space
                for i, demo in ipairs(demos) do
                    if demo.type == "h_mover" or demo.type == "v_mover" or demo.type == "d_mover" then
                        -- Create fresh view for text positioning
                        local view, err = physics.create_body_view(world_id, demo.body_id)
                        if view then
                            local screen_x = origin_x + view.pos_x * scale
                            local screen_y = origin_y + view.pos_y * scale

                            nvg.fontSize(nvg_ctx, 20.0)  -- Screen pixels
                            nvg.fontFace(nvg_ctx, "roboto")
                            nvg.textAlign(nvg_ctx, nvg.ALIGN_CENTER + nvg.ALIGN_MIDDLE)
                            nvg.fillColor(nvg_ctx, nvg.rgba(0, 0, 0, 255))
                            nvg.text(nvg_ctx, screen_x, screen_y, demo.label)
                        end
                    end
                end
                nvg.save(nvg_ctx)  -- Re-enter physics space for bodies
                nvg.translate(nvg_ctx, origin_x, origin_y)
                nvg.scale(nvg_ctx, scale, scale)
            end
        end

        -- Draw bodies - reading live properties from Body objects
        for i, body in ipairs(bodies) do
            nvg.save(nvg_ctx)
            nvg.translate(nvg_ctx, body.pos_x, body.pos_y)  -- Physics coordinates directly
            nvg.rotate(nvg_ctx, body.angle)  -- No negation needed!

            -- Draw circle (radius 0.5 meters in physics units)
            local radius = 0.5

            -- Color based on velocity (faster = redder)
            local speed = math.sqrt(body.vel_x * body.vel_x + body.vel_y * body.vel_y)
            local r = math.floor(math.min(255, 100 + speed * 20))
            local g = math.floor(150 - math.min(150, speed * 10))
            local b = 100

            nvg.beginPath(nvg_ctx)
            nvg.circle(nvg_ctx, 0, 0, radius)
            nvg.fillColor(nvg_ctx, nvg.rgba(r, g, b, 255))
            nvg.fill(nvg_ctx)

            -- Draw direction indicator
            nvg.beginPath(nvg_ctx)
            nvg.moveTo(nvg_ctx, 0, 0)
            nvg.lineTo(nvg_ctx, radius, 0)
            nvg.strokeWidth(nvg_ctx, 0.1)  -- In physics units
            nvg.strokeColor(nvg_ctx, nvg.rgba(255, 255, 255, 255))
            nvg.stroke(nvg_ctx)

            nvg.restore(nvg_ctx)
        end

        -- Restore to screen coordinates for UI elements
        nvg.restore(nvg_ctx)

        -- Draw coordinate axes labels (in screen coordinates)
        nvg.fontSize(nvg_ctx, 16.0)
        nvg.fontFace(nvg_ctx, "roboto")
        nvg.textAlign(nvg_ctx, nvg.ALIGN_CENTER + nvg.ALIGN_MIDDLE)
        nvg.fillColor(nvg_ctx, nvg.rgba(200, 200, 200, 255))
        -- X axis label (right side)
        nvg.text(nvg_ctx, canvas_x + canvas_w - 30, origin_y, "+X")
        -- Y axis label (bottom - Y-down means positive Y goes down)
        nvg.text(nvg_ctx, origin_x, canvas_y + canvas_h - 20, "+Y")

        -- Draw info text (in screen coordinates)
        nvg.fontSize(nvg_ctx, 14.0)
        nvg.fontFace(nvg_ctx, "roboto")
        nvg.textAlign(nvg_ctx, nvg.ALIGN_LEFT + nvg.ALIGN_TOP)
        nvg.fillColor(nvg_ctx, nvg.rgba(255, 255, 255, 255))
        nvg.text(nvg_ctx, canvas_x + 10, canvas_y + 10, "Bodies: " .. #bodies)
    end
    </script>
</head>
<body>
    <div class="header" data-model="demo_status">
        <div data-for="s : demo_status">
            <h1>Box2D Physics Demo</h1>
            <p class="status">{{s.text}}</p>
        </div>
    </div>

    <div class="canvas-container">
        <canvas id="physics_canvas" renderfunction="render_physics"/>
    </div>

    <div class="controls">
        <button onclick="emit('reset_physics')">Reset</button>
        <button onclick="emit('add_ball')">Add Ball</button>
        <button onclick="emit('impulse_all')">Impulse Up</button>
        <button onclick="emit('toggle_gravity')">Toggle Gravity</button>
    </div>

    <div class="body-list" data-model="physics_state">
        <div data-for="ps : physics_state">
            <h3>Bodies:</h3>
            <div data-for="body : ps.bodies">
                <div class="body-info">
                    <span>Ball {{body.id}}: </span>
                    <span>Pos ({{body.pos_x}}, {{body.pos_y}})</span>
                    <span>Vel ({{body.vel_x}}, {{body.vel_y}})</span>
                    <span data-if="body.awake" class="awake">AWAKE</span>
                    <span data-if="!body.awake" class="sleeping">SLEEPING</span>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
