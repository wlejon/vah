body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: rgba(80, 80, 80, 140);
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    z-index: 100000;
}

.notifications-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    background-color: #101010;
}

.notifications-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 2px #45475a;
}

h1 {
    font-size: 28px;
    color: #89b4fa;
    margin: 0;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
}

.notification-count {
    font-size: 13px;
    color: #a6adc8;
    background: #313244;
    padding: 6px 12px;
    border-radius: 12px;
}

.btn-clear-all {
    background: #f38ba8;
    color: #1e1e2e;
    padding: 8px 16px;
    border-radius: 4px;
    font-family: Roboto;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}

.btn-clear-all:hover {
    background: #eba0ac;
}

.notifications-content {
    flex: 1;
    overflow-y: auto;
    margin-bottom: 16px;
}

.empty-state {
    text-align: center;
    padding: 80px 20px;
    color: #6c7086;
}

.empty-state p {
    font-size: 18px;
    margin-bottom: 20px;
}

.btn-test {
    background: #89b4fa;
    color: #1e1e2e;
    padding: 10px 20px;
    border-radius: 4px;
    font-family: Roboto;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
}

.btn-test:hover {
    background: #74c7ec;
}

.notification-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.notification {
    display: flex;
    background: #313244;
    border-radius: 8px;
    padding: 16px;
    gap: 12px;
    position: relative;
    border-left: 4px #45475a;
}

.notification-read {
    opacity: 0.6;
}

.notification:hover {
    background: #383a4d;
}

/* Type-specific colors */
.notification-info {
    border-left-color: #89b4fa;
}

.notification-success {
    border-left-color: #a6e3a1;
}

.notification-warning {
    border-left-color: #f9e2af;
}

.notification-error {
    border-left-color: #f38ba8;
}

.notification-type-indicator {
    width: 8px;
    min-width: 8px;
    border-radius: 4px;
    margin-right: 4px;
}

.type-info {
    background: #89b4fa;
}

.type-success {
    background: #a6e3a1;
}

.type-warning {
    background: #f9e2af;
}

.type-error {
    background: #f38ba8;
}

.notification-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.notification-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
}

.notification-title {
    font-size: 16px;
    font-weight: bold;
    color: #cdd6f4;
    margin: 0;
}

.notification-time {
    font-size: 11px;
    color: #6c7086;
    white-space: nowrap;
}

.notification-message {
    font-size: 14px;
    color: #bac2de;
    margin: 0;
    line-height: 1.5;
}

.notification-source {
    font-size: 11px;
    color: #7f849c;
    font-style: italic;
}

.notification-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    min-width: 100px;
}

.notification-actions button {
    background: #45475a;
    color: #cdd6f4;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: Roboto;
    font-size: 11px;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
}

.notification-actions button:hover {
    background: #585b70;
}

.btn-action {
    background: #89b4fa;
    color: #1e1e2e;
}

.btn-action:hover {
    background: #74c7ec;
}

.btn-mark-read {
    background: #a6e3a1;
    color: #1e1e2e;
}

.btn-mark-read:hover {
    background: #94e2d5;
}

.btn-dismiss {
    background: #6c7086;
    color: #cdd6f4;
}

.btn-dismiss:hover {
    background: #7f849c;
}

.notifications-footer {
    text-align: center;
    padding-top: 16px;
    border-top: 1px #45475a;
}

.notifications-footer button {
    background: #585b70;
    color: #cdd6f4;
    padding: 8px 24px;
    border-radius: 4px;
    font-family: Roboto;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}

.notifications-footer button:hover {
    background: #6c7086;
}

/* Scrollbar styling */
scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 1px;
    background: #6c7086;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
