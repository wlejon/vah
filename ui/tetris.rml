<rml>
<head>
    <title>Tetris Game</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="tetris.rcss"/>
    <script>
    require "tetris"
    </script>
</head>
<body>
    <h1>A tetris example :)</h1>
    <div class="container">
        <canvas id="tetris-canvas"
                renderfunction="render_tetris"
                keyhandler="handle_tetris_key"
                mouseclickhandler="handle_tetris_mouse"/>
    </div>
</body>
</rml>
