<rml>
<head>
    <title>Workflow Node Editor</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="workflow_editor.rcss"/>
    <script>
    require "workflow_editor"
    </script>
</head>
<body>
    <div class="header">
        <h1>Visual Workflow Editor</h1>
        <button class="config-btn" onclick="trigger('open_node_editor', {})">Configure Node Types</button>
    </div>
    <div class="container">
        <canvas id="workflow-canvas"
                renderfunction="render_workflow"
                keyhandler="handle_workflow_key"
                mouseclickhandler="handle_workflow_click"
                mousemovehandler="handle_workflow_move"
                mousescrollhandler="handle_workflow_scroll"/>
    </div>
</body>
</rml>
