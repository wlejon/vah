/* Workflow Approval Dialog Styles */

.approval-dialog {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    background-color: #2a2a2a;
    border-width: 2px;
    border-color: #444;
    border-radius: 8px;
    font-family: Roboto;
    z-index: 1000;
}

.approval-header {
    background-color: #1a1a1a;
    padding: 16px 24px;
    border-bottom-width: 1px;
    border-bottom-color: #444;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.approval-header h2 {
    margin: 0;
    color: #fff;
    font-size: 20px;
    font-weight: 600;
}

.approval-content {
    padding: 24px;
}

.approval-message {
    margin: 0 0 16px 0;
    color: #ddd;
    font-size: 14px;
    line-height: 1.5;
}

.approval-message span {
    color: #4a9eff;
    font-weight: 600;
}

.library-list {
    margin: 16px 0;
    max-height: 400px;
    overflow-y: auto;
}

.library-item {
    display: flex;
    padding: 12px;
    margin-bottom: 8px;
    background-color: #1f1f1f;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 4px;
}

.library-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    margin-right: 12px;
    background-color: #ff9800;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 18px;
    font-weight: bold;
}

.library-info {
    flex-grow: 1;
}

.library-name {
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 4px;
}

.library-description {
    color: #bbb;
    font-size: 13px;
    margin-bottom: 4px;
    line-height: 1.4;
}

.library-access {
    color: #ff9800;
    font-size: 12px;
    font-style: italic;
}

.approval-question {
    margin: 24px 0 0 0;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-align: center;
}

.approval-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 16px 24px 24px 24px;
}

.approval-buttons button {
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    border-width: 0px;
    border-radius: 4px;
}

.approval-buttons button:hover {
    transform: translateY(-1px);
}

.approval-buttons button:active {
    transform: translateY(0);
}

.btn-deny {
    background-color: #d32f2f;
    color: white;
}

.btn-deny:hover {
    background-color: #c62828;
}

.btn-allow-once {
    background-color: #616161;
    color: white;
}

.btn-allow-once:hover {
    background-color: #757575;
}

.btn-always-allow {
    background-color: #388e3c;
    color: white;
}

.btn-always-allow:hover {
    background-color: #2e7d32;
}
