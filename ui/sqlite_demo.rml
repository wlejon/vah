<rml>
<head>
    <title>SQLite Database Demo</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="sqlite_demo.rcss"/>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>SQLite Contact Manager</h1>
            <p class="subtitle">Persistent database with editable table view</p>
        </div>

        <div class="toolbar">
            <div class="toolbar-left" data-model="contacts">
                Total: {{contacts.size}} contacts
            </div>
            <div class="toolbar-right">
                <button onclick="trigger('add_contact', {})">Add Random Contact</button>
            </div>
        </div>

        <div class="table-container" data-model="contacts">
            <div data-if="contacts.size == 0">
                <div class="empty-state">No contacts yet. Click "Add Random Contact" to create one.</div>
            </div>
            <div data-if="contacts.size > 0">
                <!-- Table header -->
                <div class="table-header">
                    <div class="col-name">Name</div>
                    <div class="col-email">Email</div>
                    <div class="col-phone">Phone</div>
                    <div class="col-company">Company</div>
                    <div class="col-actions">Actions</div>
                </div>

                <!-- Table rows using data-for -->
                <div data-for="contact, i : contacts">
                    <div class="table-row" data-attr-id="'row_' + contact.id">
                        <div class="col-name">
                            <input type="text"
                                   data-attr-value="contact.name"
                                   data-attr-data-model="'contacts'"
                                   data-attr-data-record-id="contact.id"
                                   data-attr-data-field="'name'" />
                        </div>
                        <div class="col-email">
                            <input type="text"
                                   data-attr-value="contact.email"
                                   data-attr-data-model="'contacts'"
                                   data-attr-data-record-id="contact.id"
                                   data-attr-data-field="'email'" />
                        </div>
                        <div class="col-phone">
                            <input type="text"
                                   data-attr-value="contact.phone"
                                   data-attr-data-model="'contacts'"
                                   data-attr-data-record-id="contact.id"
                                   data-attr-data-field="'phone'" />
                        </div>
                        <div class="col-company">
                            <input type="text"
                                   data-attr-value="contact.company"
                                   data-attr-data-model="'contacts'"
                                   data-attr-data-record-id="contact.id"
                                   data-attr-data-field="'company'" />
                        </div>
                        <div class="col-actions">
                            <button class="btn-save" data-event-click="trigger('save_contact', contact.id)">Save</button>
                            <button class="btn-delete" data-event-click="trigger('delete_contact', contact.id)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
