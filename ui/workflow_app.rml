<rml>
<head>
    <title>Workflow Application</title>
    <link type="text/rcss" href="reset.rcss"/>
    <link type="text/rcss" href="workflow_app.rcss"/>
    <script>
    require "workflow_editor"

    -- View navigation functions - accept document parameter from inline event handlers
    function switch_to_workflow_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', true)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_workflow_list_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', true)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_node_editor_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', true)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_workflow_config_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-config-view'):SetClass('active', true)
        doc:GetElementById('node-config-view'):SetClass('active', false)
        doc:GetElementById('approval-dialog-view'):SetClass('active', false)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_node_config_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-config-view'):SetClass('active', false)
        doc:GetElementById('node-config-view'):SetClass('active', true)
        doc:GetElementById('approval-dialog-view'):SetClass('active', false)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function show_approval_dialog(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-config-view'):SetClass('active', false)
        doc:GetElementById('node-config-view'):SetClass('active', false)
        doc:GetElementById('approval-dialog-view'):SetClass('active', true)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_execution_history_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-config-view'):SetClass('active', false)
        doc:GetElementById('node-config-view'):SetClass('active', false)
        doc:GetElementById('approval-dialog-view'):SetClass('active', false)
        doc:GetElementById('execution-history-view'):SetClass('active', true)
        doc:GetElementById('execution-details-view'):SetClass('active', false)
    end

    function switch_to_execution_details_view(doc)
        doc:GetElementById('workflow-view'):SetClass('active', false)
        doc:GetElementById('workflow-list-view'):SetClass('active', false)
        doc:GetElementById('node-editor-view'):SetClass('active', false)
        doc:GetElementById('workflow-config-view'):SetClass('active', false)
        doc:GetElementById('node-config-view'):SetClass('active', false)
        doc:GetElementById('approval-dialog-view'):SetClass('active', false)
        doc:GetElementById('execution-history-view'):SetClass('active', false)
        doc:GetElementById('execution-details-view'):SetClass('active', true)
    end

    </script>
</head>
<body>
    <!-- Main application container -->
    <div id="app-container" data-model="active_view" data-for="v,i : active_view">
        <!-- Workflow Editor View -->
        <div id="workflow-view" class="view" data-class-active="v.view == 'workflow'">
            <div class="header">
                <div class="workflow-info" data-model="active_workflow" data-if="active_workflow.size > 0" data-for="wf,i : active_workflow">
                    <h1>{{ wf.name }}</h1>
                </div>
            </div>

            <!-- Execution Controls Panel - shown when execution is active -->
            <div class="execution-controls" data-model="execution_state" data-if="execution_state.size > 0" data-for="exec,i : execution_state">
                <div class="execution-info">
                    <div class="progress-container">
                        <div class="progress-bar">
                            <div class="progress-fill" data-attr-style-width="(exec.completed_nodes / exec.total_nodes * 100) + '%'"></div>
                        </div>
                        <div class="progress-text">{{ exec.completed_nodes }}/{{ exec.total_nodes }} nodes ({{ math.floor(exec.completed_nodes / exec.total_nodes * 100) }}%)</div>
                    </div>
                    <div class="execution-status">
                        <span class="status-label">Status:</span>
                        <span class="status-value" data-attr-data-status="exec.status">{{ exec.status }}</span>
                    </div>
                    <div class="execution-time">
                        <span class="time-label">Time:</span>
                        <span class="time-value">{{ string.format('%.1f', exec.elapsed_time or 0) }}s</span>
                    </div>
                </div>
                <div class="execution-buttons">
                    <button class="pause-btn" data-attr-data-execution-id="exec.execution_id" onclick="emit('pause_execution', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))})">Pause</button>
                    <button class="step-btn" data-attr-data-execution-id="exec.execution_id" onclick="emit('step_execution', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))})">Step</button>
                    <button class="stop-btn" data-attr-data-execution-id="exec.execution_id" onclick="emit('stop_execution', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))})">Stop</button>
                </div>
            </div>

            <div class="container">
                <canvas id="workflow-canvas"
                        renderfunction="render_workflow"
                        keyhandler="handle_workflow_key"
                        mouseclickhandler="handle_workflow_click"
                        mousemovehandler="handle_workflow_move"
                        mousescrollhandler="handle_workflow_scroll"/>
            </div>
        </div>

        <!-- Workflow List View -->
        <div id="workflow-list-view" class="view" data-class-active="v.view == 'list'">
            <div class="header">
                <button class="back-btn" onclick="switch_to_workflow_view(document)">← Back to Workflow</button>
                <h1>My Workflows</h1>
                <button onclick="emit('new_workflow', {})">+ New Workflow</button>
            </div>

            <div class="main-container">
                <div class="workflows-list">
                    <div class="workflows-container" data-model="workflows" data-for="workflow,i : workflows">
                        <div class="workflow-item">
                            <div class="workflow-item-content" data-attr-data-workflow-id="workflow.id" onclick="emit('select_workflow', {id = tonumber(event.current_element:GetAttribute('data-workflow-id'))})">
                                <h3>{{ workflow.name }}</h3>
                                <p class="workflow-meta">Updated: {{ workflow.updated_at }}</p>
                            </div>
                            <button class="delete-btn" data-attr-data-workflow-id="workflow.id" onclick="emit('delete_workflow', {id = tonumber(event.current_element:GetAttribute('data-workflow-id'))})">×</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Node Type Editor View -->
        <div id="node-editor-view" class="view" data-class-active="v.view == 'node_editor'">
            <div class="header">
                <button class="back-btn" onclick="switch_to_workflow_view(document)">← Back to Workflow</button>
                <h1>Node Type Editor</h1>
                <button onclick="emit('add_new_node_type', {})">+ New Node Type</button>
            </div>

            <div class="main-container">
                <!-- Left side: List of node types -->
                <div class="node-types-list">
                    <h2>Node Types</h2>
                    <div class="node-types-container" data-model="node_types" data-for="node_type,i : node_types">
                        <div class="node-type-item" data-attr-data-node-type-id="node_type.id" onclick="emit('select_node_type', {id = tonumber(event.current_element:GetAttribute('data-node-type-id'))})">
                            <div class="color-preview" data-attr-style-background-color="'rgba(' + node_type.color_r + ',' + node_type.color_g + ',' + node_type.color_b + ',' + node_type.color_a + ')'"></div>
                            <span class="node-type-name">{{ node_type.name }}</span>
                        </div>
                    </div>
                </div>

                <!-- Right side: Editor for selected node type -->
                <div class="editor-panel" data-model="selected_node" data-if="selected_node.size > 0" data-for="node,i : selected_node">
                    <div>
                        <h2>Edit Node Type</h2>

                        <div class="form-section">
                            <label>Name:</label>
                            <input type="text" name="node_name" data-attr-value="node.name" />
                        </div>

                        <div class="form-section">
                            <label>Color:</label>
                            <div class="color-inputs">
                                <div class="color-input-group">
                                    <label>R:</label>
                                    <input type="text" name="color_r" data-attr-value="node.color_r" size="3" maxlength="3"/>
                                </div>
                                <div class="color-input-group">
                                    <label>G:</label>
                                    <input type="text" name="color_g" data-attr-value="node.color_g" size="3" maxlength="3"/>
                                </div>
                                <div class="color-input-group">
                                    <label>B:</label>
                                    <input type="text" name="color_b" data-attr-value="node.color_b" size="3" maxlength="3"/>
                                </div>
                                <div class="color-input-group">
                                    <label>A:</label>
                                    <input type="text" name="color_a" data-attr-value="node.color_a" size="3" maxlength="3"/>
                                </div>
                            </div>
                            <div class="color-preview-large" data-attr-style-background-color="'rgba(' + node.color_r + ',' + node.color_g + ',' + node.color_b + ',' + node.color_a + ')'"></div>
                        </div>

                        <div class="form-section">
                            <div class="ports-header">
                                <label>Input Ports:</label>
                                <button onclick="emit('add_input_port', {})">+ Add Input</button>
                            </div>
                            <div class="ports-list" data-for="port,i : node.inputs">
                                <div class="port-item">
                                    <input type="text" data-attr-name="'input_port_' + i" data-attr-value="port" />
                                    <button class="delete-btn" onclick="emit('delete_input_port', {index = i})">×</button>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="ports-header">
                                <label>Output Ports:</label>
                                <button onclick="emit('add_output_port', {})">+ Add Output</button>
                            </div>
                            <div class="ports-list" data-for="port,i : node.outputs">
                                <div class="port-item">
                                    <input type="text" data-attr-name="'output_port_' + i" data-attr-value="port" />
                                    <button class="delete-btn" onclick="emit('delete_output_port', {index = i})">×</button>
                                </div>
                            </div>
                        </div>

                        <div class="button-group">
                            <button class="save-btn" onclick="emit('save_node_type')">Save Changes</button>
                            <button class="delete-btn" onclick="emit('delete_node_type')">Delete Node Type</button>
                        </div>
                    </div>
                </div>

                <!-- Empty state when no node type is selected -->
                <div class="editor-panel empty-state" data-model="selected_node" data-if="selected_node.size == 0">
                    <p>Select a node type to edit, or create a new one</p>
                </div>
            </div>
        </div>

        <!-- Workflow Configuration View -->
        <div id="workflow-config-view" class="view" data-class-active="v.view == 'workflow_config'">
            <div class="header">
                <button class="back-btn" onclick="switch_to_workflow_view(document)">← Back to Workflow</button>
                <h1>Workflow Configuration</h1>
                <div></div>
            </div>

            <div class="main-container">
                <div class="config-form" data-model="workflow_config" data-if="workflow_config.size > 0" data-for="config,i : workflow_config">
                    <div class="form-section">
                        <label>Workflow Name:</label>
                        <input type="text" name="workflow_name" data-attr-value="config.name" />
                    </div>

                    <div class="form-section">
                        <label>Description:</label>
                        <textarea name="workflow_description" rows="4" data-attr-value="config.description"></textarea>
                    </div>

                    <div class="form-section">
                        <label>Required Libraries:</label>
                        <div class="libraries-list" data-model="library_list" data-for="library,j : library_list">
                            <div class="library-item">
                                <input type="checkbox" data-attr-name="'library_' + j" data-attr-checked="library.enabled" />
                                <div class="library-info">
                                    <div class="library-name">{{ library.name }}</div>
                                    <div class="library-description">{{ library.description }}</div>
                                    <div class="library-access">{{ library.access_description }}</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="button-group">
                        <button class="save-btn" onclick="emit('save_workflow_config', {workflow_id = config.workflow_id, name = document:GetElementById('workflow-config-view'):GetElementsByTagName('input')[0].value, description = document:GetElementById('workflow-config-view'):GetElementsByTagName('textarea')[0].value})">Save</button>
                        <button onclick="switch_to_workflow_view(document)">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Node Configuration Dialog -->
        <div id="node-config-view" class="view" data-class-active="v.view == 'node_config'">
            <div class="dialog-overlay">
                <div class="dialog-box" data-model="node_config" data-if="node_config.size > 0" data-for="node,i : node_config">
                    <h2>Configure Node</h2>

                    <div class="form-section">
                        <label>Node Label:</label>
                        <input type="text" name="node_label" data-attr-value="node.label" onchange="emit('node_label_changed', {value = event.parameters.value})" />
                    </div>

                    <div class="form-section">
                        <label>Inputs (comma-separated):</label>
                        <input type="text" name="node_inputs" data-attr-value="node.inputs" onchange="emit('node_inputs_changed', {value = event.parameters.value})" />
                    </div>

                    <div class="form-section">
                        <label>Outputs (comma-separated):</label>
                        <input type="text" name="node_outputs" data-attr-value="node.outputs" onchange="emit('node_outputs_changed', {value = event.parameters.value})" />
                    </div>

                    <div class="form-section">
                        <label>Script:</label>
                        <div class="script-editor-container">
                            <texteditor id="node_script_editor" onmodified="emit('node_script_modified', {content = event.parameters.content})" />
                        </div>
                    </div>

                    <div class="button-group">
                        <button class="save-btn" onclick="emit('save_node_config_from_dialog')">Save</button>
                        <button onclick="emit('cancel_node_config')">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Approval Dialog View -->
        <div id="approval-dialog-view" class="view" data-class-active="v.view == 'approval_dialog'">
            <div class="dialog-overlay">
                <div class="dialog-box approval-dialog" data-model="approval_request" data-if="approval_request.size > 0" data-for="request,i : approval_request">
                    <h2>Workflow Approval Required</h2>

                    <div class="approval-content">
                        <p>Workflow <strong>{{ request.workflow_name }}</strong> wants to run with:</p>

                        <div class="approval-libraries">
                            <div class="approval-library-list" data-for="library,j : request.libraries">
                                <div class="approval-library-item">
                                    <div class="warning-indicator">[!]</div>
                                    <div class="approval-library-info">
                                        <div class="approval-library-name">{{ library.name }}</div>
                                        <div class="approval-library-access">{{ library.access_description }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <p class="approval-question">Do you want to allow this workflow to run?</p>
                    </div>

                    <div class="button-group approval-buttons">
                        <button class="delete-btn" onclick="emit('workflow_approval_response', {workflow_id = request.workflow_id, approved = false, remember = false}); switch_to_workflow_view(document)">Deny</button>
                        <button onclick="emit('workflow_approval_response', {workflow_id = request.workflow_id, approved = true, remember = false}); switch_to_workflow_view(document)">Allow Once</button>
                        <button class="save-btn" onclick="emit('workflow_approval_response', {workflow_id = request.workflow_id, approved = true, remember = true}); switch_to_workflow_view(document)">Always Allow</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Execution History View -->
        <div id="execution-history-view" class="view" data-class-active="v.view == 'execution_history'">
            <div class="header">
                <button class="back-btn" onclick="switch_to_workflow_view(document)">← Back to Workflow</button>
                <h1>Execution History</h1>
                <button class="delete-btn" onclick="emit('clear_execution_history', {})">Clear History</button>
            </div>

            <div class="main-container">
                <div class="history-content">
                    <!-- Execution History Table -->
                    <div class="history-table" data-model="execution_history" data-if="execution_history.size > 0">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date/Time</th>
                                    <th>Status</th>
                                    <th>Duration</th>
                                    <th>Nodes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody data-for="exec,i : execution_history">
                                <tr>
                                    <td>{{ exec.started_at }}</td>
                                    <td>
                                        <span class="status-badge" data-attr-data-status="exec.status">{{ exec.status }}</span>
                                    </td>
                                    <td>{{ string.format('%.1f', exec.duration) }}s</td>
                                    <td>{{ exec.completed_nodes }}/{{ exec.total_nodes }}</td>
                                    <td>
                                        <button class="view-btn" data-attr-data-execution-id="exec.execution_id" onclick="emit('view_execution', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))}); switch_to_execution_details_view(document)">View Details</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty state when no executions exist -->
                    <div class="empty-state" data-model="execution_history" data-if="execution_history.size == 0">
                        <p>No execution history available</p>
                        <p class="empty-hint">Execute a workflow to see its history here</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Execution Details View -->
        <div id="execution-details-view" class="view" data-class-active="v.view == 'execution_details'">
            <div class="header">
                <button class="back-btn" onclick="switch_to_execution_history_view(document)">← Back to History</button>
                <h1>Execution Details</h1>
                <div></div>
            </div>

            <div class="main-container">
                <div class="details-content" data-model="execution_details" data-if="execution_details.size > 0" data-for="details,i : execution_details">
                    <!-- Execution Summary -->
                    <div class="execution-summary">
                        <div class="summary-item">
                            <span class="summary-label">Workflow:</span>
                            <span class="summary-value">{{ details.workflow_name }}</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Started:</span>
                            <span class="summary-value">{{ details.started_at }}</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Status:</span>
                            <span class="status-badge" data-attr-data-status="details.status">{{ details.status }}</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Duration:</span>
                            <span class="summary-value">{{ string.format('%.1f', details.duration) }}s</span>
                        </div>
                    </div>

                    <!-- Node Results Section -->
                    <div class="details-section">
                        <h2>Node Results</h2>
                        <div class="node-results-table">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Node Name/ID</th>
                                        <th>Status</th>
                                        <th>Inputs</th>
                                        <th>Outputs</th>
                                    </tr>
                                </thead>
                                <tbody data-for="node,j : details.nodes">
                                    <tr>
                                        <td>{{ node.node_name }} (#{{ node.node_id }})</td>
                                        <td>
                                            <span class="status-badge" data-attr-data-status="node.status">{{ node.status }}</span>
                                        </td>
                                        <td><pre class="json-content">{{ node.inputs }}</pre></td>
                                        <td><pre class="json-content">{{ node.outputs }}</pre></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Execution Log Section -->
                    <div class="details-section">
                        <h2>Execution Log</h2>
                        <div class="execution-log">
                            <div class="log-entries" data-for="log,k : details.logs">
                                <div class="log-entry" data-attr-data-level="log.level">
                                    <span class="log-timestamp">{{ log.timestamp }}</span>
                                    <span class="log-level">{{ log.level }}</span>
                                    <span class="log-message">{{ log.message }}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="button-group">
                        <button onclick="switch_to_execution_history_view(document)">Back to History</button>
                        <button data-attr-data-execution-id="details.execution_id" onclick="emit('export_execution_log', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))})">Export Log</button>
                        <button class="delete-btn" data-attr-data-execution-id="details.execution_id" onclick="emit('delete_execution', {execution_id = tonumber(event.current_element:GetAttribute('data-execution-id'))}); switch_to_execution_history_view(document)">Delete Execution</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
