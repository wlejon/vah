body {
    font-family: Roboto;
    margin: 0;
    padding: 0;
    background-color: #1c1e22;
    color: #dcdcdc;
}

.header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    background-color: #1c1e22;
}

h1 {
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: #ffffff;
}

.config-btn {
    padding: 8px 16px;
    background-color: #4a7c99;
    color: #ffffff;
    border-radius: 4px;
    cursor: pointer;
    font-size: 13px;
}

.config-btn:hover {
    background-color: #5a8ca9;
}

.config-btn:active {
    background-color: #3a6c89;
}

.container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 40px;
    left: 0;
    bottom: 0;
    right: 0;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    focus: auto;
}
