body {
    font-family: Roboto;
    margin: 0;
    padding: 0;
    background-color: #1c1e22;
    color: #dcdcdc;
}

h1 {
    margin: 0;
    padding: 10px;
    font-size: 20px;
    color: #ffffff;
    height: 40px;
}

.container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 40px;
    left: 0;
    bottom: 0;
    right: 0;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    focus: auto;
}
