body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: #1e1e2e;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

/* Header */
.header {
    background: #313244;
    padding: 16px 20px;
    border-bottom: 2px #45475a;
    flex-shrink: 0;
}

h1 {
    font-size: 20px;
    color: #89b4fa;
    margin: 0 0 4px 0;
}

.status {
    font-size: 12px;
    color: #6c7086;
}

.status.connected {
    color: #a6e3a1;
}

.status.error {
    color: #f38ba8;
}

/* Messages container */
.messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* Message styles */
.message {
    padding: 12px 16px;
    border-radius: 8px;
    max-width: 80%;
    line-height: 1.5;
}

.message.user {
    background: #89b4fa;
    color: #1e1e2e;
    align-self: flex-end;
    margin-left: auto;
}

.message.assistant {
    background: #313244;
    color: #cdd6f4;
    align-self: flex-start;
    border: 1px #45475a;
}

.message.system {
    background: #45475a;
    color: #a6adc8;
    align-self: center;
    font-size: 12px;
    font-style: italic;
    max-width: 60%;
    text-align: center;
}

/* Streaming indicator */
.streaming {
    padding: 12px 16px;
    border-radius: 8px;
    background: #313244;
    color: #cdd6f4;
    align-self: flex-start;
    border: 1px #45475a;
    max-width: 80%;
    line-height: 1.5;
}

/* Input area */
.input-area {
    background: #313244;
    padding: 16px 20px;
    border-top: 2px #45475a;
    flex-shrink: 0;
    display: flex;
    gap: 12px;
    align-items: center;
}

input.text {
    flex: 1;
    background: #45475a;
    color: #cdd6f4;
    border: 1px #6c7086;
    border-radius: 6px;
    padding: 10px 14px;
    font-family: Roboto;
    font-size: 14px;
}

input.text:focus {
    border: 1px #89b4fa;
}

button {
    background: #89b4fa;
    color: #1e1e2e;
    border-radius: 6px;
    padding: 10px 20px;
    font-family: Roboto;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
}

button:hover {
    background: #74c7ec;
}

button:active {
    background: #89dceb;
}

button.secondary {
    background: #45475a;
    color: #cdd6f4;
}

button.secondary:hover {
    background: #585b70;
}

/* Scrollbar */
scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 1px;
    background: #6c7086;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

/* Markdown styles */
.message p {
    margin: 0 0 8px 0;
}

.message p:last-child {
    margin-bottom: 0;
}

.message strong {
    font-weight: bold;
    color: #f5e0dc;
}

.message em {
    font-style: italic;
}

.message .inline-code {
    background: #45475a;
    color: #f5c2e7;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
    font-size: 13px;
}

.message pre {
    background: #181825;
    color: #cdd6f4;
    padding: 12px;
    border-radius: 6px;
    margin: 8px 0;
    font-family: monospace;
    font-size: 13px;
    line-height: 1.4;
}

.message code {
    font-family: monospace;
}

.message ul {
    margin: 8px 0;
    padding-left: 20px;
}

.message li {
    margin: 4px 0;
}

.message h1, .message h2, .message h3,
.message h4, .message h5, .message h6 {
    color: #89b4fa;
    margin: 12px 0 8px 0;
    font-weight: bold;
}

.message h1 { font-size: 20px; }
.message h2 { font-size: 18px; }
.message h3 { font-size: 16px; }
.message h4 { font-size: 14px; }
.message h5 { font-size: 13px; }
.message h6 { font-size: 12px; }

.message a {
    color: #89dceb;
    text-decoration: underline;
}

.message a:hover {
    color: #74c7ec;
}

/* Table styles */
.message table.md-table {
    width: 100%;
    margin: 12px 0;
    background: #181825;
    border-radius: 6px;
}

.message table.md-table th {
    background: #313244;
    color: #89b4fa;
    font-weight: bold;
    padding: 8px 12px;
    text-align: left;
    border-bottom: 2px #45475a;
}

.message table.md-table td {
    padding: 8px 12px;
    border-bottom: 1px #313244;
}

.message table.md-table tr:last-child td {
    
}

.message table.md-table tbody tr:hover {
    background: #1e1e2e;
}

/* Same styling for streaming */
.streaming p,
.streaming strong,
.streaming em,
.streaming .inline-code,
.streaming pre,
.streaming code,
.streaming ul,
.streaming li,
.streaming h1, .streaming h2, .streaming h3,
.streaming h4, .streaming h5, .streaming h6,
.streaming a,
.streaming table.md-table,
.streaming table.md-table th,
.streaming table.md-table td {
    /* Inherit from .message styles */
}