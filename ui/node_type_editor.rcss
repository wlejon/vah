body {
    font-family: Roboto;
    margin: 0;
    padding: 0;
    background-color: #1c1e22;
    color: #dcdcdc;
}

.header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #2d2f33;
    border-bottom: 1px #404244;
}

h1 {
    margin: 0;
    font-size: 24px;
    color: #ffffff;
}

h2 {
    margin: 0 0 15px 0;
    font-size: 18px;
    color: #ffffff;
}

button {
    padding: 8px 16px;
    background-color: #4a7dc4;
    color: #ffffff;
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
}

button:hover {
    background-color: #5a8dd4;
}

button:active {
    background-color: #3a6db4;
}

.back-btn {
    background-color: #5a5c5e;
}

.back-btn:hover {
    background-color: #6a6c6e;
}

.back-btn:active {
    background-color: #4a4c4e;
}

.main-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    position: absolute;
    top: 60px;
    bottom: 0;
    left: 0;
    right: 0;
}

/* Left panel - Node Types List */
.node-types-list {
    width: 300px;
    background-color: #252729;
    padding: 20px;
    border-right: 1px #404244;
    overflow-y: auto;
}

.node-types-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.node-type-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12px;
    background-color: #2d2f33;
    border-radius: 6px;
    cursor: pointer;
    gap: 12px;
}

.node-type-item:hover {
    background-color: #353739;
}

.node-type-item.selected {
    background-color: #3d5a7a;
    border: 1px #4a7dc4;
}

.color-preview {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px rgba(255, 255, 255, 0.2);
}

.node-type-name {
    font-size: 14px;
    color: #dcdcdc;
}

/* Right panel - Editor */
.editor-panel {
    flex: 1;
    padding: 20px 30px;
    overflow-y: auto;
}

.editor-panel.empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
}

.editor-panel.empty-state p {
    font-size: 16px;
    color: #808080;
}

.form-section {
    margin-bottom: 25px;
}

.form-section label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    color: #a0a0a0;
    font-weight: bold;
}

input[type="text"] {
    padding: 8px 12px;
    background-color: #2d2f33;
    color: #dcdcdc;
    border: 1px #404244;
    border-radius: 4px;
    font-size: 14px;
    width: 100%;
}

input[type="text"]:focus {
    border-color: #4a7dc4;
}

/* Color inputs */
.color-inputs {
    display: flex;
    flex-direction: row;
    gap: 12px;
    margin-bottom: 12px;
}

.color-input-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.color-input-group label {
    margin: 0;
    font-size: 12px;
    font-weight: normal;
}

.color-input-group input {
    width: 50px;
}

.color-preview-large {
    width: 100%;
    height: 60px;
    border-radius: 6px;
    border: 1px rgba(255, 255, 255, 0.2);
}

/* Ports section */
.ports-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.ports-header button {
    padding: 6px 12px;
    font-size: 12px;
}

.ports-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.port-item {
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
}

.port-item input {
    flex: 1;
}

.delete-btn {
    background-color: #c44a4a;
    width: 32px;
    height: 32px;
    padding: 0;
    font-size: 20px;
    line-height: 1;
}

.delete-btn:hover {
    background-color: #d45a5a;
}

.delete-btn:active {
    background-color: #b43a3a;
}

/* Button group */
.button-group {
    display: flex;
    flex-direction: row;
    gap: 12px;
    margin-top: 30px;
}

.save-btn {
    background-color: #4ac44a;
}

.save-btn:hover {
    background-color: #5ad45a;
}

.save-btn:active {
    background-color: #3ab43a;
}
