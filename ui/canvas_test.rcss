body {
    font-family: Roboto;
    margin: 0;
    padding: 20px;
    background-color: #1a1a1e;
    color: #e0e0e0;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

h1 {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 10px;
    color: #ffffff;
}

h2 {
    font-size: 24px;
    font-weight: 500;
    margin-top: 20px;
    margin-bottom: 10px;
    color: #60a5fa;
}

p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 10px;
}

.canvas-container {
    margin-top: 30px;
    margin-bottom: 30px;
    margin-left: 0px;
    margin-right: 0px;
    border-width: 2px;
    border-color: #3a3a3e;
    border-radius: 8px;
    overflow: hidden;
    background-color: #2a2a2e;
}

canvas {
    display: block;
    width: 100%;
    height: 600px;
}

.info {
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #3a3a3e;
    border-radius: 8px;
    padding: 20px;
    margin-top: 20px;
}

ul {
    margin: 10px 0;
    padding-left: 30px;
}

li {
    margin: 8px 0;
    line-height: 1.6;
}

.success {
    color: #4ade80;
    font-weight: 500;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 0px;
    margin-right: 0px;
}
