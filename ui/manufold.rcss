body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: #1e1e2e;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

.manufold-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

/* Header */
.header {
    background: #313244;
    padding: 20px 24px;
    border-bottom: 2px #45475a;
    flex-shrink: 0;
}

h1 {
    font-size: 24px;
    color: #89b4fa;
    margin: 0 0 4px 0;
    font-weight: 600;
}

.subtitle {
    font-size: 13px;
    color: #6c7086;
    margin: 0 0 12px 0;
}

.status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding: 8px 12px;
    background: #45475a;
    border-radius: 6px;
}

.status {
    font-size: 13px;
    color: #a6adc8;
}

.state-indicator {
    font-size: 12px;
    color: #89b4fa;
    font-weight: 500;
}

/* Panel common styles */
.welcome-panel,
.ingestion-panel,
.exploration-panel,
.validation-panel,
.model-design-panel,
.transformation-panel,
.view-generation-panel,
.complete-panel {
    padding: 24px;
    flex: 1;
}

/* Welcome panel */
.welcome-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.welcome-panel p {
    color: #a6adc8;
    margin: 0 0 20px 0;
    line-height: 1.5;
}

.drop-zone {
    background: #313244;
    border: 2px #45475a;
    border-radius: 12px;
    padding: 60px 40px;
    text-align: center;
    margin: 20px 0;
}

.drop-zone p {
    font-size: 16px;
    color: #6c7086;
    margin: 0;
}

.instructions {
    background: #313244;
    padding: 20px;
    border-radius: 8px;
    margin-top: 20px;
}

.instructions h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.instructions ol {
    margin: 0;
    padding-left: 24px;
    color: #a6adc8;
}

.instructions li {
    margin: 8px 0;
    line-height: 1.5;
}

/* Ingestion panel */
.ingestion-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.ingestion-panel p {
    color: #a6adc8;
    margin: 8px 0;
}

/* Exploration panel */
.exploration-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.exploration-panel > p {
    color: #a6adc8;
    margin: 0 0 20px 0;
    line-height: 1.5;
}

.file-list {
    background: #313244;
    padding: 16px;
    border-radius: 8px;
    margin: 20px 0;
}

.file-list h3 {
    font-size: 14px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.files {
    max-height: 200px;
    overflow-y: auto;
}

.file-item {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    background: #45475a;
    border-radius: 4px;
    margin: 4px 0;
}

.file-name {
    color: #cdd6f4;
    font-size: 13px;
}

.file-type {
    color: #6c7086;
    font-size: 12px;
    font-family: "JetBrains Mono";
}

/* Conversation */
.conversation {
    margin: 20px 0;
    padding: 16px;
    background: #313244;
    border-radius: 8px;
    max-height: 400px;
    overflow-y: auto;
}

.conversation h3 {
    font-size: 14px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.message {
    padding: 12px;
    margin: 8px 0;
    border-radius: 6px;
    line-height: 1.5;
}

.message.user {
    background: #45475a;
    border-left: 3px #89b4fa;
}

.message.assistant {
    background: #1e1e2e;
    border-left: 3px #a6e3a1;
}

.message.system {
    background: #1e1e2e;
    border-left: 3px #f9e2af;
}

.message-role {
    font-size: 11px;
    color: #6c7086;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 4px;
}

.message-content {
    color: #cdd6f4;
    font-size: 13px;
    white-space: pre-wrap;
    width: 100%;
    min-height: 40px;
    background: transparent;
    border: none;
}

texteditor.message-content {
    background: transparent;
    border: none;
}

/* Thinking indicator */
.thinking-indicator {
    background: #313244;
    padding: 16px;
    border-radius: 8px;
    margin: 20px 0;
    text-align: center;
}

.thinking-indicator p {
    color: #89b4fa;
    margin: 0;
    font-style: italic;
}

/* Action panel */
.action-panel {
    margin: 20px 0;
    display: flex;
    gap: 12px;
}

/* Input area */
.input-area {
    background: #313244;
    padding: 16px;
    border-radius: 8px;
    margin: 20px 0;
    display: flex;
    gap: 12px;
    align-items: center;
}

input.text {
    flex: 1;
    background: #45475a;
    color: #cdd6f4;
    border: 1px #6c7086;
    border-radius: 6px;
    padding: 10px 14px;
    font-family: Roboto;
    font-size: 14px;
}

input.text:focus {
    border: 1px #89b4fa;
}

/* Validation panel */
.validation-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.validation-panel > p {
    color: #a6adc8;
    margin: 0 0 20px 0;
}

.comprehension-doc {
    background: #313244;
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
}

.comprehension-doc h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.doc-content {
    color: #cdd6f4;
    line-height: 1.6;
    white-space: pre-wrap;
}

.feedback-area {
    background: #313244;
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
}

.feedback-area h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 8px 0;
}

.feedback-area p {
    color: #a6adc8;
    margin: 0 0 12px 0;
}

textarea {
    width: 100%;
    min-height: 100px;
    background: #45475a;
    color: #cdd6f4;
    border: 1px #6c7086;
    border-radius: 6px;
    padding: 12px;
    font-family: Roboto;
    font-size: 14px;
    line-height: 1.5;
}

textarea:focus {
    border: 1px #89b4fa;
}

.button-group {
    display: flex;
    gap: 12px;
    margin-top: 12px;
}

/* Model Design panel */
.model-design-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.model-design-panel > p {
    color: #a6adc8;
    margin: 0 0 20px 0;
}

.schema-display {
    background: #313244;
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
}

.schema-display h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.schema-display pre {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: "JetBrains Mono";
    font-size: 13px;
    line-height: 1.4;
}

/* Transformation panel */
.transformation-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.transformation-panel > p {
    color: #a6adc8;
    margin: 0 0 20px 0;
}

.scripts-display {
    margin: 20px 0;
}

.scripts-display h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

.script-item {
    background: #313244;
    padding: 16px;
    border-radius: 8px;
    margin: 12px 0;
}

.script-item h4 {
    font-size: 14px;
    color: #f9e2af;
    margin: 0 0 8px 0;
}

.script-item pre {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 12px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: "JetBrains Mono";
    font-size: 12px;
    line-height: 1.4;
}

.progress-bar {
    background: #313244;
    height: 40px;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    margin: 20px 0;
}

.progress-fill {
    background: #a6e3a1;
    height: 100%;
    width: 0%;
    transition: width 0.3s;
}

.progress-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #1e1e2e;
    font-size: 13px;
    font-weight: 600;
}

/* View Generation panel */
.view-generation-panel h2 {
    font-size: 20px;
    color: #cdd6f4;
    margin: 0 0 12px 0;
}

.view-generation-panel > p {
    color: #a6adc8;
    margin: 0 0 20px 0;
}

.response-display {
    background: #313244;
    padding: 20px;
    border-radius: 8px;
    margin: 20px 0;
}

.response-display h3 {
    font-size: 16px;
    color: #89b4fa;
    margin: 0 0 12px 0;
}

/* Complete panel */
.complete-panel h2 {
    font-size: 20px;
    color: #a6e3a1;
    margin: 0 0 12px 0;
}

.complete-panel p {
    color: #cdd6f4;
    margin: 8px 0;
    line-height: 1.5;
}

/* Buttons */
button {
    background: #89b4fa;
    color: #1e1e2e;
    border-radius: 6px;
    padding: 10px 20px;
    font-family: Roboto;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
}

button:hover {
    background: #74c7ec;
}

button:active {
    background: #89dceb;
}

button.primary {
    background: #a6e3a1;
    color: #1e1e2e;
}

button.primary:hover {
    background: #94e2d5;
}

button.secondary {
    background: #45475a;
    color: #cdd6f4;
}

button.secondary:hover {
    background: #585b70;
}

/* Global actions */
.global-actions {
    padding: 16px 24px;
    border-top: 2px #45475a;
    background: #313244;
    flex-shrink: 0;
}

/* Scrollbar */
scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 1px;
    background: #6c7086;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
