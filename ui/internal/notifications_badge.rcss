body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background-color: transparent;
    width: 60px;
    height: 60px;
    padding: 0;
    margin: 0;
    right: 0;
    top: 0;
    box-sizing: border-box;
    z-index: 100000;
}

.notification-badge-container {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.notification-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 42px;
    height: 42px;
    background: #1e1e2e;
    border: 2px solid #89b4fa;
    border-radius: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
}

.notification-badge:hover {
    background: #89b4fa;
}

.notification-badge:hover .badge-count {
    color: #1e1e2e;
}

.badge-count {
    font-size: 16px;
    font-weight: 600;
    color: #89b4fa;
}
