body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: transparent;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    z-index: 100000;
    pointer-events: none;
}

.notification-badge-container {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.notification-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 48px;
    height: 48px;
    background: #89b4fa;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
}

.notification-badge:hover {
    background: #74c7ec;
}

.badge-count {
    font-size: 18px;
    font-weight: bold;
    color: #1e1e2e;
}
