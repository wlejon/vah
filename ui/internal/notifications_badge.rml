<rml>
<head>
    <title>Notification Badge</title>
    <link type="text/rcss" href="/ui/reset.rcss"/>
    <link type="text/rcss" href="notifications_badge.rcss"/>
</head>
<body>
    <div class="notification-badge-container" data-model="notification_ui_state">
        <div class="notification-badge" data-event-click="trigger('toggle_notifications')">
            <span class="badge-count">{{notification_ui_state[0].count}}</span>
        </div>
    </div>
</body>
</rml>
