<rml>
<head>
    <title>Notifications</title>
    <link type="text/rcss" href="ui/reset.rcss"/>
    <link type="text/rcss" href="ui/internal/notification_overlay.rcss" />
</head>
<body>
    <div id="feed-toggle" onclick="toggle_notification_feed(document)">
        <span class="count" data-model="notifications">{{ count }}</span>
    </div>

    <div id="notification-stream">
        <div class="stream-header">
            <h3>Activity</h3>
            <button id="close-feed" onclick="toggle_notification_feed(document)">X</button>
        </div>

        <div class="notification-items" data-model="notifications">
            <div class="notification-item" data-for="notif : notifications"
                 data-if="!notif.pending_removal"
                 data-class-info="notif.type == 0"
                 data-class-progress="notif.type == 1"
                 data-class-success="notif.type == 2"
                 data-class-warning="notif.type == 3"
                 data-class-error="notif.type == 4"
                 data-class-agent-question="notif.type == 5"
                 data-class-agent-thinking="notif.type == 6"
                 data-class-file-op="notif.type == 7"
                 data-attr-notif-id="notif.id"
                 data-attr-notif-title="notif.title"
                 data-attr-notif-message="notif.message"
                 data-attr-notif-thread="notif.thread_name"
                 data-attr-notif-expanded="notif.expanded_content"
                 data-attr-notif-expandable="notif.expandable"
                 onclick="expand_notification_from_element(event)">

                <div class="notif-icon">
                    <span data-if="notif.type == 0">i</span>
                    <span data-if="notif.type == 1">...</span>
                    <span data-if="notif.type == 2">OK</span>
                    <span data-if="notif.type == 3">!</span>
                    <span data-if="notif.type == 4">X</span>
                    <span data-if="notif.type == 5">?</span>
                    <span data-if="notif.type == 6">...</span>
                    <span data-if="notif.type == 7">F</span>
                </div>

                <div class="notif-content">
                    <div class="notif-header">
                        <span class="notif-title">{{ notif.title }}</span>
                        <span class="notif-thread">{{ notif.thread_name }}</span>
                    </div>
                    <p class="notif-message" data-if="notif.message">{{ notif.message }}</p>
                    <div class="expand-indicator" data-if="notif.expandable">Click for details...</div>

                    <!-- Action buttons -->
                    <div class="notif-actions">
                        <button class="action-btn" data-for="action : notif.actions"
                                data-attr-notif-id="notif.id"
                                data-attr-action-id="action.id"
                                data-attr-thread-id="notif.thread_id"
                                onclick="handle_notification_action(event)">{{ action.label }}</button>
                    </div>
                </div>

                <button class="dismiss-btn"
                        data-if="notif.dismissible"
                        data-attr-notif-id="notif.id"
                        onclick="dismiss_notification_from_element(event)">×</button>
            </div>
        </div>
    </div>

    <!-- Expansion Modal -->
    <div id="notification-expansion-modal">
        <div class="expansion-content">
            <div class="expansion-header">
                <div class="expansion-title-section">
                    <h2 class="expansion-title" id="expansion-title"></h2>
                    <div class="expansion-meta" id="expansion-meta"></div>
                </div>
                <button class="expansion-close-btn" onclick="close_expansion_modal()">×</button>
            </div>
            <div class="expansion-body" id="expansion-body"></div>
        </div>
    </div>
</body>
</rml>
