/* App Navigation Overlay Styles */

body {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 999998;
    background-color: transparent;
}

#app-close-button {
    position: fixed;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(49, 50, 68, 0.95);
    border-radius: 6px;
    cursor: pointer;
    pointer-events: auto;
}

#app-close-button:hover {
    background: rgba(69, 71, 90, 0.95);
}

.close-icon {
    font-size: 18px;
    font-weight: bold;
    color: #f38ba8;
}

.close-label {
    font-size: 14px;
    color: #cdd6f4;
}
