html {
    width: 100%;
    height: 100%;
}

body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: #1e1e2e;
    width: 100%;
    height: 100%;
    padding: 20px;
    box-sizing: border-box;
}

.header {
    text-align: center;
    margin-bottom: 20px;
}

h1 {
    font-size: 32px;
    color: #89b4fa;
    margin-bottom: 10px;
}

.subtitle {
    font-size: 14px;
    color: #6c7086;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
}

.toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 12px 16px;
    background: #313244;
    border-radius: 6px;
}

.toolbar-left {
    font-size: 13px;
    color: #a6adc8;
}

.toolbar-right {
    display: flex;
    gap: 10px;
}

button {
    background: #89b4fa;
    color: #1e1e2e;
    padding: 8px 16px;
    border-radius: 4px;
    font-family: Roboto;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #74c7ec;
}

.table-container {
    background: #313244;
    border-radius: 8px;
    padding: 16px;
    max-height: 600px;
    overflow-y: auto;
    overflow-x: auto;
}

.table-header,
.table-row {
    display: flex;
    padding: 12px;
    gap: 16px;
    border-bottom: 1px #45475a;
}

.table-header {
    background: #45475a;
    border-radius: 4px;
    font-weight: bold;
    color: #f5c2e7;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.table-row {
    background: #181825;
    margin-top: 4px;
    border-radius: 4px;
}

.table-row:hover {
    background: #1e1e2e;
}

input[type=text] {
    background: #11111b;
    color: #cdd6f4;
    border: 1px #45475a;
    padding: 4px 8px;
    border-radius: 3px;
    font-family: Roboto;
    font-size: 13px;
    width: 100%;
    box-sizing: border-box;
}

input[type=text]:focus {
    border-color: #89b4fa;
}

.col-name {
    flex: 2;
    min-width: 150px;
}

.col-email {
    flex: 2;
    min-width: 180px;
}

.col-phone {
    flex: 1.5;
    min-width: 120px;
}

.col-company {
    flex: 1.5;
    min-width: 140px;
}

.col-actions {
    flex: 1.5;
    min-width: 120px;
    text-align: right;
    display: flex;
    gap: 4px;
    justify-content: flex-end;
}

.col-actions button {
    padding: 4px 12px;
    font-size: 11px;
}

.btn-save {
    background: #a6e3a1;
}

.btn-save:hover {
    background: #94e2d5;
}

.btn-delete {
    background: #f38ba8;
}

.btn-delete:hover {
    background: #f5c2e7;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #6c7086;
    font-size: 16px;
}

.error {
    background: #f38ba8;
    color: #1e1e2e;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
}

scrollbarvertical {
    width: 8px;
}

scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 1px;
    background: #6c7086;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}