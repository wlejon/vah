<rml>
<head>
    <title>File Browser</title>
    <link type="text/rcss" href="reset.rcss"/>
    <style>
        html {
            width: 100%;
            height: 100%;
        }

        body {
            font-family: Roboto;
            font-size: 14px;
            color: #cdd6f4;
            background: #1e1e2e;
            width: 100%;
            height: 100%;
            padding: 20px;
            box-sizing: border-box;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 28px;
            color: #89b4fa;
            margin-bottom: 10px;
        }

        .browser-container {
            background: #313244;
            padding: 20px;
            border-radius: 8px;
            max-width: 900px;
            margin: 0 auto;
        }

        .path-bar {
            background: #181825;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-family: Roboto;
            font-size: 13px;
            color: #a6adc8;
        }

        .file-list {
            background: #181825;
            padding: 8px;
            border-radius: 6px;
            min-height: 400px;
            max-height: 500px;
            overflow-y: auto;
        }

        .file-item {
            display: flex;
            padding: 10px 12px;
            margin-bottom: 2px;
            border-radius: 4px;
            cursor: pointer;
            background: transparent;
        }

        .file-item:hover {
            background: #313244;
        }

        .file-icon {
            width: 30px;
            font-size: 18px;
        }

        .file-name {
            flex: 1;
            color: #cdd6f4;
        }

        .file-size {
            color: #6c7086;
            font-size: 12px;
            width: 80px;
            text-align: right;
        }

        scrollbarvertical {
            width: 8px;
        }

        scrollbarvertical slidertrack {
            width: 8px;
            background: transparent;
        }

        scrollbarvertical sliderbar {
            width: 6px;
            margin-left: 1px;
            background: #6c7086;
            border-radius: 3px;
            min-height: 30px;
        }

        scrollbarvertical sliderarrowdec,
        scrollbarvertical sliderarrowinc {
            width: 0px;
            height: 0px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>File Browser</h1>
    </div>

    <div class="browser-container">
        <div data-model="browser_info">
            <div data-for="info : browser_info">
                <div class="path-bar">
                    <span>{{info.current_path}}</span>
                </div>
            </div>
        </div>

        <div class="file-list" data-model="files">
            <div data-for="file, i : files">
                <div class="file-item" onclick="emit('navigate', {path = file.path, is_directory = file.is_directory})">
                    <span class="file-icon">{{file.icon}}</span>
                    <span class="file-name">{{file.name}}</span>
                    <span class="file-size">{{file.size}}</span>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
