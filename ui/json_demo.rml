<rml>
<head>
    <title>JSON Data Viewer</title>
    <link type="text/rcss" href="reset.rcss"/>
    <style>
        html {
            width: 100%;
            height: 100%;
        }

        body {
            font-family: Roboto;
            font-size: 14px;
            color: #cdd6f4;
            background: #1e1e2e;
            width: 100%;
            height: 100%;
            padding: 20px;
            box-sizing: border-box;
            overflow-y: auto;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 32px;
            color: #89b4fa;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 14px;
            color: #6c7086;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .stats-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            justify-content: center;
        }

        .stat-item {
            background: #313244;
            padding: 20px 40px;
            border-radius: 8px;
            text-align: center;
            border: 2px #45475a;
        }

        .stat-value {
            font-size: 36px;
            font-weight: bold;
            color: #94e2d5;
            margin-bottom: 8px;
        }

        .stat-label {
            font-size: 12px;
            color: #6c7086;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title {
            font-size: 20px;
            color: #f5c2e7;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .projects-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 20px;
        }

        .project-card {
            background: #313244;
            padding: 20px;
            border-radius: 8px;
            border: 2px #45475a;
        }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        h3 {
            font-size: 18px;
            color: #89b4fa;
            margin: 0;
        }

        .project-status {
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .status-active {
            background: #a6e3a1;
            color: #1e1e2e;
        }

        .status-planned {
            background: #f9e2af;
            color: #1e1e2e;
        }

        .project-desc {
            color: #a6adc8;
            margin-bottom: 16px;
            line-height: 1.5;
        }

        .project-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .meta-item {
            color: #6c7086;
            font-size: 13px;
        }

        .tags {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tag {
            background: #45475a;
            color: #cdd6f4;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
        }

        .footer {
            text-align: center;
            color: #6c7086;
            font-size: 12px;
            margin-top: 30px;
        }

        .error {
            background: #f38ba8;
            color: #1e1e2e;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            font-weight: bold;
        }

        scrollbarvertical {
            width: 8px;
        }

        scrollbarvertical slidertrack {
            width: 8px;
            background: transparent;
        }

        scrollbarvertical sliderbar {
            width: 6px;
            margin-left: 1px;
            background: #6c7086;
            border-radius: 3px;
            min-height: 30px;
        }

        scrollbarvertical sliderarrowdec,
        scrollbarvertical sliderarrowinc {
            width: 0px;
            height: 0px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>JSON Data Viewer</h1>
            <p class="subtitle">Parsing and visualizing JSON data from files</p>
        </div>

        <div id="stats_container" class="stats-grid">
            <!-- Statistics will be populated here -->
        </div>

        <div class="section-title">Projects</div>
        <div id="projects_container" class="projects-grid">
            <!-- Projects will be populated here -->
        </div>

        <div id="last_updated" class="footer">
            <!-- Last updated info -->
        </div>
    </div>
</body>
</rml>
