<rml>
<head>
    <title>Notifications Panel</title>
    <link type="text/rcss" href="/ui/reset.rcss"/>
    <link type="text/rcss" href="notifications_panel.rcss"/>
</head>
<body>
    <div class="notifications-panel-overlay">
        <div class="notifications-container">
            <div class="notifications-header">
                <h1>Notifications</h1>
                <div class="header-actions" data-model="notifications">
                    <span class="notification-count">{{notifications.size}} active</span>
                    <button class="btn-clear-all"
                            data-if="notifications.size > 0"
                            onclick="emit('dismiss_all_notifications')">
                        Dismiss All
                    </button>
                </div>
            </div>

            <div class="notifications-content" data-model="notifications">
                <div data-if="notifications.size == 0">
                    <div class="empty-state">
                        <p>No notifications</p>
                        <button class="btn-test" onclick="emit('add_test_notifications')">
                            Add Test Notifications
                        </button>
                    </div>
                </div>

                <!-- Notification list -->
                <div data-if="notifications.size > 0" class="notification-list">
                    <div data-for="notif, i : notifications">
                        <div data-attr-class="'notification notification-' + notif.type + (notif.read == 1 ? ' notification-read' : '') + (notif.expandable == 1 ? ' notification-expandable' : '') + (notif.is_expanded == 1 ? ' notification-expanded' : '')">

                            <!-- Type indicator -->
                            <div data-attr-class="'notification-type-indicator type-' + notif.type"></div>

                            <!-- Content -->
                            <div class="notification-content">
                                <div class="notification-header-row">
                                    <h3 class="notification-title"
                                        data-attr-data-notification-id="notif.id"
                                        data-attr-data-expandable="notif.expandable"
                                        onclick="
                                            local notif_id = event.current_element:GetAttribute('data-notification-id')
                                            local expandable = event.current_element:GetAttribute('data-expandable')
                                            if expandable == '1' then
                                                emit('toggle_notification_expand', {id = tonumber(notif_id)})
                                            end
                                        ">
                                        <span>{{notif.title}}</span>
                                        <span data-if="notif.expandable == 1" class="expand-indicator">{{notif.is_expanded == 1 ? 'v' : '>'}}</span>
                                    </h3>
                                    <span class="notification-time">{{notif.timestamp}}</span>
                                </div>
                                <p class="notification-message">{{notif.message}}</p>

                                <!-- Expanded content - text format (default, readonly texteditor for selection) -->
                                <div data-if="notif.is_expanded == 1 && notif.expanded_content != '' && (notif.content_format == '' || notif.content_format == 'text')" class="notification-expanded-text">
                                    <div class="notification-texteditor-wrapper">
                                        <texteditor class="notification-texteditor" data-attr-value="notif.expanded_content" />
                                    </div>
                                </div>

                                <!-- Expanded content - markup format -->
                                <div data-if="notif.is_expanded == 1 && notif.expanded_content != '' && notif.content_format == 'markup'" class="notification-expanded-markup" data-rml="notif.expanded_content">
                                </div>

                                <div data-if="notif.source != ''" class="notification-source">
                                    Source: {{notif.source}}
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="notification-actions">
                                <!-- Expand button for expandable notifications -->
                                <button data-if="notif.expandable == 1"
                                        class="btn-action"
                                        data-attr-data-notification-id="notif.id"
                                        onclick="
                                            local notif_id = event.current_element:GetAttribute('data-notification-id')
                                            emit('toggle_notification_expand', {id = tonumber(notif_id)})
                                        ">
                                    {{notif.is_expanded == 1 ? 'Hide Details' : 'View Details'}}
                                </button>

                                <!-- Mark as read (only if unread) -->
                                <button data-if="notif.read == 0"
                                        class="btn-mark-read"
                                        data-attr-data-notification-id="notif.id"
                                        onclick="
                                            local notif_id = event.current_element:GetAttribute('data-notification-id')
                                            emit('mark_notification_read', {id = tonumber(notif_id)})
                                        ">
                                    Mark Read
                                </button>

                                <!-- Dismiss -->
                                <button class="btn-dismiss"
                                        data-attr-data-notification-id="notif.id"
                                        onclick="
                                            local notif_id = event.current_element:GetAttribute('data-notification-id')
                                            emit('dismiss_notification', {id = tonumber(notif_id)})
                                        ">
                                    Dismiss
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="notifications-footer">
                <button onclick="emit('hide_notifications')">Close</button>
            </div>
        </div>
    </div>
</body>
</rml>
