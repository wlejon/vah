body {
    font-family: Roboto;
    font-size: 14px;
    color: #cdd6f4;
    background: rgba(80,80,80,140);
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    z-index: 100000;
}

.notifications-panel-overlay {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
}

.notifications-container {
    width: 90%;
    max-width: 800px;
    height: 80%;
    padding: 0;
    box-sizing: border-box;
    background: #1e1e2e;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
}

.notifications-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    background: #181825;
    border-radius: 16px 16px 0 0;
}

h1 {
    font-size: 20px;
    font-weight: bold;
    color: #cdd6f4;
    margin: 0;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
}

.notification-count {
    font-size: 12px;
    color: #bac2de;
    background: #313244;
    padding: 4px 10px;
    border-radius: 8px;
}

.btn-clear-all {
    background: #313244;
    color: #f38ba8;
    padding: 6px 14px;
    border-radius: 6px;
    font-family: Roboto;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
}

.btn-clear-all:hover {
    background: #f38ba8;
    color: #1e1e2e;
}

.notifications-content {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
    min-height: 0;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #6c7086;
}

.empty-state p {
    font-size: 15px;
    margin-bottom: 24px;
    color: #7f849c;
}

.btn-test {
    background: #313244;
    color: #89b4fa;
    padding: 8px 16px;
    border-radius: 6px;
    font-family: Roboto;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
}

.btn-test:hover {
    background: #45475a;
    border-color: #89b4fa;
}

.notification-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.notification {
    display: flex;
    background: #181825;
    border-radius: 10px;
    padding: 14px;
    gap: 12px;
    position: relative;
}

.notification-read {
    opacity: 0.5;
}

.notification:hover {
    background: #262637;
    border-color: #45475a;
}

.notification-info {
    border-left-color: #89b4fa;
}

.notification-success {
    border-left-color: #a6e3a1;
}

.notification-warning {
    border-left-color: #f9e2af;
}

.notification-error {
    border-left-color: #f38ba8;
}

.notification-type-indicator {
    width: 6px;
    min-width: 6px;
    border-radius: 3px;
    align-self: stretch;
}

.type-info {
    background: #89b4fa;
}

.type-success {
    background: #a6e3a1;
}

.type-warning {
    background: #f9e2af;
}

.type-error {
    background: #f38ba8;
}

.notification-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.notification-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
}

.notification-title {
    font-size: 14px;
    font-weight: 600;
    color: #cdd6f4;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.notification-title[data-expandable='1'] {
    cursor: pointer;
    text-decoration: underline;
}

.notification-title[data-expandable='1']:hover {
    color: #89b4fa;
}

.expand-indicator {
    font-size: 10px;
    color: #6c7086;
}

.notification-time {
    font-size: 11px;
    color: #6c7086;
    white-space: nowrap;
    flex-shrink: 0;
}

.notification-message {
    font-size: 13px;
    color: #a6adc8;
    margin: 0;
    line-height: 1.6;
}

.notification-source {
    font-size: 10px;
    color: #6c7086;
    font-style: italic;
}

.notification-expanded-text {
    margin-top: 8px;
}

.notification-texteditor-wrapper {
    width: 100%;
    max-height: 400px;
    overflow-y: auto;
    background: #11111b;
    border-radius: 6px;
    border-width: 1px;
    border-color: #313244;
    box-sizing: border-box;
}

.notification-texteditor {
    width: 100%;
    font-size: 12px;
    color: #bac2de;
    background: transparent;
    padding: 10px;
    font-family: "JetBrains Mono";
    line-height: 1.5;
    border-width: 0;
}

.notification-expanded-markup {
    font-size: 12px;
    color: #bac2de;
    background: #11111b;
    padding: 12px;
    border-radius: 6px;
    line-height: 1.6;
    margin-top: 8px;
    max-height: 300px;
    overflow-y: auto;
}

.notification-expanded-markup p {
    margin: 8px 0;
}

.notification-expanded-markup ul {
    margin: 8px 0;
    padding-left: 20px;
}

.notification-expanded-markup li {
    margin: 4px 0;
}

.notification-expanded-markup strong {
    color: #cdd6f4;
    font-weight: 600;
}

.notification-expanded-markup pre {
    background: #181825;
    padding: 8px;
    border-radius: 4px;
    font-family: "JetBrains Mono";
    font-size: 11px;
    margin: 8px 0;
    color: #a6adc8;
    white-space: pre-wrap;
}

.notification-texteditor-wrapper scrollbarvertical,
.notification-expanded-markup scrollbarvertical {
    width: 8px;
}

.notification-texteditor-wrapper scrollbarvertical slidertrack,
.notification-expanded-markup scrollbarvertical slidertrack {
    width: 8px;
    background: transparent;
}

.notification-texteditor-wrapper scrollbarvertical sliderbar,
.notification-expanded-markup scrollbarvertical sliderbar {
    width: 4px;
    margin-left: 2px;
    background: #45475a;
    border-radius: 2px;
    min-height: 20px;
}

.notification-texteditor-wrapper scrollbarvertical sliderbar:hover,
.notification-expanded-markup scrollbarvertical sliderbar:hover {
    background: #585b70;
}

.notification-texteditor-wrapper scrollbarvertical sliderarrowdec,
.notification-texteditor-wrapper scrollbarvertical sliderarrowinc,
.notification-expanded-markup scrollbarvertical sliderarrowdec,
.notification-expanded-markup scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

.notification-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: flex-start;
    align-self: flex-start;
    min-width: 100px;
}

.notification-actions button {
    background: transparent;
    color: #a6adc8;
    padding: 5px 10px;
    border-radius: 5px;
    font-family: Roboto;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    min-width: 90px;
    white-space: nowrap;
}

.notification-actions button:hover {
    background: #313244;
    border-color: #585b70;
}

.btn-action {
    color: #89b4fa;
    border-color: #89b4fa;
}

.btn-action:hover {
    background: #89b4fa;
    color: #1e1e2e;
}

.btn-mark-read {
    color: #a6e3a1;
    border-color: #a6e3a1;
}

.btn-mark-read:hover {
    background: #a6e3a1;
    color: #1e1e2e;
}

.btn-dismiss {
    color: #6c7086;
    border-color: #45475a;
}

.btn-dismiss:hover {
    background: #45475a;
    color: #cdd6f4;
}

.notifications-footer {
    text-align: center;
    padding: 16px 24px;
    background: #181825;
    border-radius: 0 0 16px 16px;
}

.notifications-footer button {
    background: transparent;
    color: #a6adc8;
    padding: 8px 20px;
    border-radius: 6px;
    font-family: Roboto;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
}

.notifications-footer button:hover {
    background: #313244;
    border-color: #585b70;
}

scrollbarvertical {
    width: 10px;
}

scrollbarvertical slidertrack {
    width: 10px;
    background: transparent;
}

scrollbarvertical sliderbar {
    width: 6px;
    margin-left: 2px;
    background: #45475a;
    border-radius: 3px;
    min-height: 30px;
}

scrollbarvertical sliderbar:hover {
    background: #585b70;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
