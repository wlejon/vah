body {
    height: 100%;
    width: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: white;
    background-color: #161617ff;
}

.launcher-container {
    width: 100%;
    height: 1000px;
    background-color: #313244;
    padding: 40px;
    border-radius: 12px;
    margin: 60px auto;
    overflow: auto;
}

h1 {
    font-size: 42px;
    margin-bottom: 12px;
    color: #89b4fa;
    font-weight: bold;
}

.subtitle {
    font-size: 16px;
    color: #a6adc8;
    margin-bottom: 40px;
}

.app-grid {
    /* Grid layout not supported by RmlUI, using flexbox instead */
    display: block;
}

.app-card {
    background: #45475a;
    padding: 24px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 16px;
    display: inline-block;
    width: 48%;
    margin-right: 2%;
    vertical-align: top;
}

.app-card:hover {
    background: #585b70;
}

.app-icon {
    font-size: 32px;
    margin-bottom: 12px;
    color: #89b4fa;
}

.app-name {
    font-size: 20px;
    font-weight: bold;
    color: #cdd6f4;
    margin-bottom: 8px;
}

.app-description {
    font-size: 14px;
    color: #a6adc8;
    line-height: 1.4;
}

.footer {
    margin-top: 32px;
    padding-top: 24px;
    text-align: center;
    font-size: 14px;
    color: #6c7086;
}